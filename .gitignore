# ── Credentials & Secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.pyd

# ── Virtual Environments ─────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Runtime Data (generated, never committed) ────────────────────────────────
data/
logs/
*.log
*.db
*.sqlite

# ── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Testing ──────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Scratch / one-off analysis output (never project source) ────────────────
scratch_*
