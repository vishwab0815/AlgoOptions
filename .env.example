# =============================================================================
#  AlgoPilotX Options — Environment Configuration  (TEMPLATE — copy to .env)
#  NIFTY options premium-selling PAPER TRADING engine (DhanHQ v2).
#  Invalid values reject at startup rather than falling back silently.
# =============================================================================


# ── 1. DhanHQ CREDENTIALS ────────────────────────────────────── [required]
# Access token is valid 24h. Regenerate daily after 15:30 IST or before
# 09:15 IST (scripts/generate_token.py) — one generated mid-session expires
# mid-session tomorrow. Used READ-ONLY: option chain, expiry list, margin
# calculator, scrip master, and the real-time WebSocket premium feed. No
# order is ever placed with this token anywhere in this codebase.
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token_regenerate_daily


# =============================================================================
#  OPTIONS ENGINE — NIFTY premium-selling PAPER TRADING (run_options.py)
#  Pure Heikin-Ashi pattern (GREEN->RED->RED) — no RSI, no volume gate, no
#  profit ratchet. Exit is the trailing stop + 15:00 IST EOD square-off.
#  See algopilot/options/. OPTIONS_PAPER_TRADING=false is refused at startup.
# =============================================================================
OPTIONS_ENABLED=true
OPTIONS_PAPER_TRADING=true          # true = paper (no orders) | false = LIVE: real orders, real money
OPTIONS_PAPER_CAPITAL=250000.0
OPTIONS_CANDLE_TIMEFRAME=5m         # 1m or 5m only
OPTIONS_MAX_CONCURRENT=1
OPTIONS_MAX_LOTS_PER_TRADE=5
OPTIONS_LOT_SIZE=65                 # NSE-specified NIFTY lot size (confirmed live) — the engine
                                     # prefers the live scrip-master value the moment it resolves;
                                     # this is only the starting default. Check nseindia.com if unsure.

OPTIONS_DB_PATH=data/options_ledger.db   # SQLite paper-trading ledger — trades + events

# Advanced — defaults shown, rarely need changing.
#OPTIONS_NIFTY_SECURITY_ID=13        # DhanHQ's NIFTY 50 index security id (IDX_I segment)
#OPTIONS_NIFTY_SEGMENT=IDX_I
#OPTIONS_EXCHANGE_SEGMENT=NSE_FNO
#OPTIONS_FALLBACK_MARGIN_PER_LOT=130000.0   # used only if a live DhanHQ margin lookup fails
#OPTIONS_POLL_INTERVAL_SECS=1.0      # maintenance loop cadence (spot poll / heartbeat) — NOT the
                                     # premium feed, which is real-time WebSocket ticks
#OPTIONS_CHAIN_MIN_INTERVAL_SECS=5.0 # min gap between option-chain calls (spot/band only); DhanHQ's
                                     # real limit proved stricter than documented — a 429 backs off
                                     # harder automatically

# ── Entry window / expiry ──────────────────────────────────────────────────
#OPTIONS_ENTRY_START=09:30            # no new entries before this (HH:MM IST); 09:15 = from the open
#OPTIONS_ROLL_ON_EXPIRY_DAY=false     # true = on expiry day trade next week's contract, not 0 DTE

# ── Costs (ESTIMATES — check against a real Dhan contract note) ────────────
#OPTIONS_APPLY_CHARGES=true           # false = show gross P&L only
#OPTIONS_BROKERAGE_PER_ORDER=20.0
#OPTIONS_STT_PCT=0.10                 # sell side only
#OPTIONS_EXCHANGE_TXN_PCT=0.0495
#OPTIONS_SEBI_PCT=0.0001
#OPTIONS_STAMP_DUTY_PCT=0.003         # buy side only
#OPTIONS_GST_PCT=18.0

# ── Candle timing ──────────────────────────────────────────────────────────
#OPTIONS_CANDLE_CLOSE_GRACE_MS=0      # 0 = candles close and signals fire at exactly hh:mm:00.000
#OPTIONS_OFFICIAL_CANDLES=true        # decide on DhanHQ's own bar (= the chart), fetched at the close
                                     # (~45 ms); false = the candle built from live-feed ticks
#OPTIONS_OFFICIAL_CANDLE_WAIT_MS=1500 # longest wait for that bar before using the live-feed candle

# ── Profit lock (extra exit — the Heikin-Ashi stop loss is unchanged) ───────
# Sold at 123: premium touches 113 (10 pts) -> buy back if it comes back to 113;
# touches 110 -> still 113; 107 -> 110; 104 -> 107 ... one step behind the best.
#OPTIONS_PROFIT_LOCK=true
#OPTIONS_PROFIT_LOCK_START_POINTS=10
#OPTIONS_PROFIT_LOCK_STEP_POINTS=3

# ── LIVE ORDERS (used only when OPTIONS_PAPER_TRADING=false) ────────────────
# Run live ONLY on the machine whose public IPv4 is registered in Dhan
# (web.dhan.co -> DhanHQ Trading APIs -> Static IP). Orders from any other
# IP are refused by Dhan.
#OPTIONS_MAX_DAILY_LOSS=3000          # Rs net loss for the day -> no new trades (default 3000 in live)
#OPTIONS_LIVE_MAX_LOTS=1              # hard cap per trade
#OPTIONS_LIVE_ORDER_TYPE=MARKET       # MARKET, or LIMIT (marketable limit, see buffer below)
#OPTIONS_LIVE_LIMIT_BUFFER_PCT=3.0    # LIMIT orders: this % through the last price
#OPTIONS_STOP_LIMIT_BUFFER_PCT=10.0   # exchange stop-limit: limit = trigger + this %
#OPTIONS_STOP_ESCALATE_SECS=3.0       # stop crossed but unfilled this long -> market buy-back
# Kill switch: create an empty file data/KILL -> squares off everything and stops.
