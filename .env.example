# =============================================================================
#  AlgoPilotX Options — settings  (TEMPLATE — copy to .env)
#  NIFTY weekly options, sell-only, Heikin-Ashi 5-minute candles, DhanHQ v2.
#  Strategy: GREEN -> RED -> RED, sold at candle 3's close; stop = HA High
#  2 candles back. Every setting is listed here with its value. A wrong value
#  stops the engine at startup with a clear message.
#  Your PIN and TOTP key are NOT here — they go in secrets.env (VM only).
# =============================================================================


# ── 1. DHAN ACCOUNT ─────────────────────────────────────────────────────────
# The token lasts 24 hours. scripts/daily_pipeline.py makes a new one every
# night at 21:00 (PIN + TOTP) and writes it here.
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_access_token_made_nightly_by_daily_pipeline


# ── 2. MODE AND MONEY ───────────────────────────────────────────────────────
OPTIONS_ENABLED=true
# true = paper (no real orders) | false = LIVE: real orders, real money
OPTIONS_PAPER_TRADING=true
# Paper mode only: the pretend capital used to size trades.
OPTIONS_PAPER_CAPITAL=250000.0
# Live: once the day's NET loss reaches this (Rs), no new trades that day.
OPTIONS_MAX_DAILY_LOSS=3000
# At most this many trades a day, CE and PE together. 0 = no limit.
OPTIONS_MAX_TRADES_PER_DAY=6
# Live: never more than this many lots in one trade.
OPTIONS_LIVE_MAX_LOTS=1
# Paper: never more than this many lots in one trade.
OPTIONS_MAX_LOTS_PER_TRADE=5
# Open trades at the same time (keep 1).
OPTIONS_MAX_CONCURRENT=1
# NIFTY lot size. Used only until Dhan's contract list gives the real one.
OPTIONS_LOT_SIZE=65


# ── 3. STRIKES ──────────────────────────────────────────────────────────────
# premium = CE and PE each trade the strike whose premium is between MIN and
#           MAX — in or out of the money doesn't matter. Several in range ->
#           the one closest to the middle (125). NIFTY 22,233: CE 22100 Rs 145,
#           CE 22200 Rs 112 -> CE 22200.
#           A side keeps its strike until its premium leaves
#           MIN-BUFFER..MAX+BUFFER (95-155), and never switches while a trade
#           is open — the range picks the strike for the NEXT trade only.
# spot    = PUT = NIFTY rounded down to the hundred, CALL = +100.
OPTIONS_STRIKE_PICK=premium
OPTIONS_PREMIUM_MIN=100
OPTIONS_PREMIUM_MAX=150
OPTIONS_PREMIUM_BUFFER=5
# Strike grid: 100 (22000, 22100 ...) or 50 (22050 too).
OPTIONS_STRIKE_STEP=100


# ── 4. CANDLES ──────────────────────────────────────────────────────────────
# Candle size: 5m (or 1m). Pattern: candle 1 GREEN, candle 2 RED (its HA Low
# is the level), candle 3 RED and breaks it -> sell at candle 3's close.
# Stop: HA High 2 candles back — candle 2's while candle 4 trades, candle 3's
# while candle 5 trades, and so on, moved at every close.
OPTIONS_CANDLE_TIMEFRAME=5m


# ── 5. PROFIT LOCK (off: the exit is the HA stop only) ──────────────────────
# true = an extra exit: first lock at START points, then every STEP points
# (8, 11, 14 ...), one step behind the best. Sold at 100: touches 92 -> lock
# 92 | 89 -> still 92 | 86 -> 89 | 83 -> 86 ... Buy back when it comes back.
OPTIONS_PROFIT_LOCK=false
OPTIONS_PROFIT_LOCK_START_POINTS=8
OPTIONS_PROFIT_LOCK_STEP_POINTS=3


# ── 6. TIMES (IST, HH:MM) ───────────────────────────────────────────────────
# No new trades before this. 09:15 = from the open.
OPTIONS_ENTRY_START=09:15
# Every open trade is bought back at this time, and no new trade after it.
# Allowed 09:20-15:15 (Dhan closes intraday positions itself from ~15:18).
OPTIONS_SQUAREOFF_AT=15:10
# The engine stops itself at this time once no trade is open. Empty = never.
OPTIONS_AUTO_STOP_AT=15:31
# true = on expiry day trade next week's contract instead of today's.
OPTIONS_ROLL_ON_EXPIRY_DAY=false


# ── 7. LIVE ORDERS (used only when OPTIONS_PAPER_TRADING=false) ─────────────
# Live orders work ONLY from the computer whose IP is registered with Dhan
# (the VM, 135.13.32.41). Orders from any other IP are refused by Dhan.
# Sell / buy-back orders: MARKET, or LIMIT (a limit this % past the last price).
OPTIONS_LIVE_ORDER_TYPE=MARKET
OPTIONS_LIVE_LIMIT_BUFFER_PCT=3.0
# The stop at the exchange is a stop-limit: limit = trigger + this %.
OPTIONS_STOP_LIMIT_BUFFER_PCT=10.0
# If the price is past the stop and that order still hasn't filled after
# this many seconds, the engine cancels it and buys back at market.
OPTIONS_STOP_ESCALATE_SECS=3.0


# ── 8. CANDLE DATA ──────────────────────────────────────────────────────────
# true = decide on Dhan's own 5-minute candle (the same one the chart shows).
OPTIONS_OFFICIAL_CANDLES=true
# Longest wait for Dhan's candle (ms) before using the live-feed candle.
OPTIONS_OFFICIAL_CANDLE_WAIT_MS=1500
# Wait this many ms after the candle boundary before deciding. 0 = exactly on it.
OPTIONS_CANDLE_CLOSE_GRACE_MS=0


# ── 9. CHARGES (estimates; compare with a real Dhan contract note) ─────────
# false = show P&L without charges.
OPTIONS_APPLY_CHARGES=true
OPTIONS_BROKERAGE_PER_ORDER=20.0
OPTIONS_STT_PCT=0.10
OPTIONS_EXCHANGE_TXN_PCT=0.0495
OPTIONS_SEBI_PCT=0.0001
OPTIONS_STAMP_DUTY_PCT=0.003
OPTIONS_GST_PCT=18.0


# ── 10. ADVANCED (rarely changed) ───────────────────────────────────────────
# Trade history database.
OPTIONS_DB_PATH=data/options_ledger.db
# Dhan's ids for the NIFTY 50 index and the options segment.
OPTIONS_NIFTY_SECURITY_ID=13
OPTIONS_NIFTY_SEGMENT=IDX_I
OPTIONS_EXCHANGE_SEGMENT=NSE_FNO
# Margin per lot (Rs) used only if Dhan's margin lookup fails.
OPTIONS_FALLBACK_MARGIN_PER_LOT=130000.0
# Housekeeping loop (seconds). Prices come live from the feed.
OPTIONS_POLL_INTERVAL_SECS=1.0
# Minimum seconds between option-chain calls (strikes + NIFTY, every ~5 s).
OPTIONS_CHAIN_MIN_INTERVAL_SECS=5.0


# ── STOPPING THE ENGINE ─────────────────────────────────────────────────────
# Create an empty file data/STOP -> the engine stops once no trade is open.
# Create an empty file data/KILL -> buys back everything now and stops.
