# Copy this file to  secrets.env  ON THE VM ONLY, and fill it in there.
# Never commit it, never zip it, never paste it anywhere.
#
# Your Kite Connect app's API SECRET (developers.kite.trade -> your app).
# scripts/kite_login.py uses it to turn the morning login into the day's
# access token: checksum = sha256(api_key + request_token + api_secret).

KITE_API_SECRET=
