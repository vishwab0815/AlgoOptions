# Copy this file to  secrets.env  ON THE VM ONLY, and fill it in there.
# Never commit it, never zip it, never paste these values anywhere.
# Together they can log into your Dhan account.
#
# Used by scripts/auto_token.py (and the daily pipeline) to create the daily
# access token without a browser: Dhan -> My Profile -> Access DhanHQ APIs ->
# Set-up TOTP gives the TOTP secret (the text key, not the 6-digit code).

DHAN_PIN=
DHAN_TOTP_SECRET=
